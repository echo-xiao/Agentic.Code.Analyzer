{
  "name": "rocket-chat-code-analyzer",
  "version": "1.0.0",
  "description": "Graph-native code navigator for Rocket.Chat monorepo, exposed as an MCP server",
  "main": "src/server/index.ts",
  "type": "module",
  "scripts": {
    "prewarm": "NODE_OPTIONS=\"--max-old-space-size=8192\" npx tsx src/server/index.ts --prewarm",
    "start": "NODE_OPTIONS=\"--max-old-space-size=8192\" npx tsx src/server/index.ts",
    "inspect": "npx @modelcontextprotocol/inspector npx tsx src/server/index.ts",
    "gen:mcp": "NODE_OPTIONS=\"--max-old-space-size=8192\" npx tsx src/eval/gen.ts --mode=mcp",
    "eval:tools": "NODE_OPTIONS=\"--max-old-space-size=8192\" npx tsx src/eval/tools.ts",
    "eval:retrieval": "NODE_OPTIONS=\"--max-old-space-size=8192\" npx tsx src/eval/retrieval.ts",
    "report": "NODE_OPTIONS=\"--max-old-space-size=8192\" npx tsx src/eval/report.ts",
    "judge": "npx tsx src/eval/judge.ts",
    "summaries:gen": "npx tsx src/eval/summarize.ts",
    "truth": "npx tsx src/eval/truth.ts",
    "wiki:map": "npx tsx src/wikimap/build.ts",
    "refresh": "npm run prewarm && npm run gen:mcp && npm run judge && npm run eval:tools && npm run eval:retrieval && npm run report",
    "test": "tsx --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "cli-progress": "^3.12.0",
    "fuzzysort": "^3.1.0",
    "glob": "^13.0.6",
    "ts-morph": "^21.0.1"
  },
  "devDependencies": {
    "@google/generative-ai": "^0.21.0",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^20.11.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3"
  }
}
