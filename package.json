{
  "name": "rocket-chat-code-analyzer",
  "version": "1.0.0",
  "description": "Graph-native code navigator for Rocket.Chat monorepo, exposed as an MCP server",
  "main": "src/server/index.ts",
  "type": "module",
  "scripts": {
    "prewarm": "NODE_OPTIONS=\"--max-old-space-size=8192\" npx tsx src/server/index.ts --prewarm",
    "start": "NODE_OPTIONS=\"--max-old-space-size=8192\" npx tsx src/server/index.ts",
    "inspect": "npx @modelcontextprotocol/inspector npx tsx src/server/index.ts",
    "gen:nomcp": "npx tsx src/eval/gen-gemini-nomcp.ts",
    "gen:mcp": "NODE_OPTIONS=\"--max-old-space-size=8192\" npx tsx src/eval/gen-gemini-mcp-selfloop.ts",
    "eval:1": "NODE_OPTIONS=\"--max-old-space-size=8192\" npx tsx src/eval/eval-1-nomcp-vs-mcp.ts",
    "eval:2": "NODE_OPTIONS=\"--max-old-space-size=8192\" npx tsx src/eval/eval-2-mcp-tools.ts",
    "eval:3": "npx tsx src/eval/eval-3-mcp-vs-claude.ts",
    "eval:4": "npx tsx src/eval/eval-4-agy.ts",
    "refresh": "npm run prewarm && npm run gen:nomcp && npm run gen:mcp && npm run eval:1 && npm run eval:2 && npm run eval:3 && npx tsx src/eval/report.ts",
    "agy": "agy --model gemini-2.5-flash",
    "agy:pro": "agy --model gemini-2.5-pro"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "cli-progress": "^3.12.0",
    "fuzzysort": "^3.1.0",
    "glob": "^13.0.6",
    "ts-morph": "^21.0.1"
  },
  "devDependencies": {
    "@google/generative-ai": "^0.21.0",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^20.11.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3"
  }
}
