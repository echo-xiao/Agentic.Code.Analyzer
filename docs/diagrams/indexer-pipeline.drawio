<mxfile host="app.diagrams.net">
  <diagram name="Indexer Pipeline" id="indexer">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="600">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="260" height="560" as="geometry"/>
        </mxCell>
        <mxCell id="title" value="Indexer" style="text;html=1;fontSize=16;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="20" y="30" width="260" height="25" as="geometry"/>
        </mxCell>

        <mxCell id="source" value="Source Code&#xa;.ts / .tsx / .js" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="70" width="160" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="hasher" value="hasher.ts&#xa;Incremental MD5&#xa;skip unchanged" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#999;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="150" width="160" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="skeleton" value="skeleton.ts&#xa;AST parse (ts-morph, allowJs)&#xa;signatures + 8 edge types&#xa;strip function bodies" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#999;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="235" width="160" height="65" as="geometry"/>
        </mxCell>

        <mxCell id="embedder" value="embedder.ts&#xa;Gemini embedding-001&#xa;symbol → float32[768]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#999;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="335" width="160" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="index" value="GLOBAL_INDEX&#xa;symbols map&#xa;callGraph&#xa;fileDependents&#xa;embeddings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="420" width="160" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="localdb" value="local-db.ts&#xa;persisted cache" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="525" width="160" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="source" target="hasher" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="hasher" target="skeleton" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a3" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="skeleton" target="embedder" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a4" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="embedder" target="index" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a5" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="index" target="localdb" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a6" value="load from cache" style="edgeStyle=orthogonalEdgeStyle;dashed=1;fontSize=9;" edge="1" source="localdb" target="index" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="250" y="545"/><mxPoint x="250" y="455"/></Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
